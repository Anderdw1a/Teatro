---
import { clsx, type ClassValue } from 'clsx';
import { twMerge } from 'tailwind-merge';

interface Props {
  href?: string;
  variant?: 'ghost' | 'filled';
  class?: string;
  [key: string]: any;
}

const { href, variant = 'ghost', class: className, ...rest } = Astro.props;

const baseStyles = 'px-[20px] py-[7px] rounded-full font-body text-caption transition-[background-color,color,transform,border-color] duration-duration-fast border-2 text-center inline-block cursor-pointer uppercase tracking-widest active:scale-[0.97] tactile outline-none focus-visible:ring-2 focus-visible:ring-alert-red focus-visible:ring-offset-2 focus-visible:ring-offset-midnight-ink';

const variants = {
  ghost: 'border-paper-white text-paper-white bg-transparent hover:bg-paper-white hover:text-midnight-ink',
  filled: 'border-paper-white bg-paper-white text-midnight-ink hover:bg-transparent hover:text-paper-white',
};

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class={twMerge(clsx(baseStyles, variants[variant], className))}
  {...rest}
>
  <slot />
</Tag>
